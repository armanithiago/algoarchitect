{
  "ci": {
    "collect": {
      "startServerCommand": "npm run preview -- --port 4173 --strictPort",
      "startServerReadyPattern": "4173",
      "startServerReadyTimeout": 30000,
      "url": ["http://localhost:4173/"],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "screenEmulation": { "mobile": true, "width": 360, "height": 640, "deviceScaleFactor": 2, "disabled": false },
        "throttlingMethod": "simulate",
        "chromeFlags": "--headless --no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "categories:accessibility": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "categories:best-practices": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "meta-viewport": "error",
        "color-contrast": "error",
        "target-size": "error"
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci/reports" }
  }
}
